list=[3,5,6,8,2] --Sorting list in ascending using sort function
list.sort()
print(list)

list=[3,5,6,8,2] --Sorting list in descending using sort function
list.sort(reverse=True)
print(list)

names = ["banana", "apple", "cherry", "mango"] --Sorting the string of list in asc
names.sort()
print(names)

names = ["banana", "apple", "cherry", "mango"] --Using sorted function which returns a new sorted list.
sorted_names = sorted(names)
print(sorted_names)
